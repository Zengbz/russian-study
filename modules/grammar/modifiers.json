    {
      "id": "modifiers-agreement",
      "title": "形容词的性数配合",
      "goal": "让“新的、好的、大的”跟名词配合。",
      "level": "基础",
      "prerequisites": [
        "basics-gender",
        "basics-plural"
      ],
      "sections": [
        {
          "title": "用途与规则",
          "text": "形容词修饰名词时，主格形式随名词的性与数变化。本节用новый这一组；不要只按中文词尾猜，也不要看物品主人的性别。",
          "table": {
            "headers": [
              "情境／基本形式",
              "本节用法／词形",
              "说明"
            ],
            "rows": [
              [
                "па́спорт：阳性",
                "но́вый па́спорт",
                "新的护照"
              ],
              [
                "ка́рта：阴性",
                "но́вая ка́рта",
                "新的卡"
              ],
              [
                "ме́сто：中性",
                "но́вое ме́сто",
                "新的位置"
              ],
              [
                "су́мки：复数",
                "но́вые су́мки",
                "新的包，多个"
              ]
            ]
          }
        },
        {
          "title": "读懂，再开口",
          "text": "先听完整例句，再留意本节的词形和搭配。能看懂后，遮住例句回忆。新词的意思随中文例句给出。",
          "examples": [
            {
              "ru": "Э́то но́вый па́спорт.",
              "zh": "这是新护照。"
            },
            {
              "ru": "Э́то но́вая ка́рта.",
              "zh": "这是新卡。"
            },
            {
              "ru": "Э́то но́вое ме́сто.",
              "zh": "这是新的位置。"
            }
          ]
        },
        {
          "title": "常见错误与学习范围",
          "text": "复数новые不再分阳、阴、中性。синий的阴性是синяя，хороший的阴性是хорошая；不同词不能只换最后一个字母。本节先练новый一组。"
        }
      ],
