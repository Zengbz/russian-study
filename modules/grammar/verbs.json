            "headers": [
              "情境／基本形式",
              "本节用法／词形",
              "说明"
            ],
            "rows": [
              [
                "чита́ть",
                "я чита́ю",
                "读→我读"
              ],
              [
                "говори́ть",
                "я говорю́",
                "说→我说"
              ],
              [
                "слу́шать",
                "вы слу́шаете",
                "听→您听"
              ],
              [
                "хочу́＋原形",
                "Я хочу́ чита́ть.",
                "我想读书"
              ]
            ]
          }
        },
        {
          "title": "读懂，再开口",
