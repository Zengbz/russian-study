              ],
              [
                "чита́ть",
                "动词原形",
                "表示读这一动作"
              ],
              [
                "но́вый",
                "形容词",
                "描述新的"
              ],
              [
                "я",
                "人称代词",
                "表示我"
              ],
              [
                "Я чита́ю.",
                "主语＋动作",
                "я是我，читаю是我读"
              ]
